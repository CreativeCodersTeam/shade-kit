<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>shade-kit</AssemblyName>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>shade-kit</ToolCommandName>
        <PackageId>CreativeCoders.ShadeKit.Cli</PackageId>
        <Description>SHADE kit (Smart Harness for AI Driven Engineering) CLI that runs AI agents through a guided, gated software lifecycle.</Description>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <!-- A publish for a runtime identifier produces the self-contained single-file binary. -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="CreativeCoders.ShadeKit.Cli.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CreativeCoders.Cli.Hosting" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CreativeCoders.ShadeKit.Core\CreativeCoders.ShadeKit.Core.csproj" />
    </ItemGroup>

</Project>
